{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Obscyra-app/nurm-vla-adaptation-evidence/main/schemas/public-result-card.schema.json",
  "title": "NURM VLA public result card",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "metricNumber": {
      "anyOf": [
        {"const": 0},
        {"type": "number", "minimum": 1e-12, "maximum": 1e12},
        {"type": "number", "minimum": -1e12, "maximum": -1e-12}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SYNTHETIC_DEMO"}}},
      "then": {
        "properties": {
          "data": {"properties": {"permission_reference": {"const": "SYNTHETIC_FIXTURE"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "PUBLIC_RESULT"}}},
      "then": {
        "properties": {
          "data": {
            "properties": {
              "permission_reference": {
                "type": "string",
                "pattern": "^(https://[^\\s]+|urn:[A-Za-z0-9][A-Za-z0-9:._/-]+)$",
                "not": {"const": "SYNTHETIC_FIXTURE"}
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "schema",
    "status",
    "title",
    "model",
    "data",
    "comparison",
    "adapter_audit",
    "metrics",
    "claims",
    "disclosure"
  ],
  "properties": {
    "schema": {"const": "nurm.vla-public-result-card.v1"},
    "status": {"enum": ["SYNTHETIC_DEMO", "PUBLIC_RESULT"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "revision", "license", "parameter_class"],
      "properties": {
        "repo_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "parameter_class": {"type": "string", "minLength": 1}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "license",
        "public_disclosure_allowed",
        "permission_basis",
        "permission_reference",
        "heldout_unit",
        "train_units",
        "evaluation_units"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "public_disclosure_allowed": {"const": true},
        "permission_basis": {"type": "string", "minLength": 8},
        "permission_reference": {
          "oneOf": [
            {"const": "SYNTHETIC_FIXTURE"},
            {"type": "string", "pattern": "^(https://[^\\s]+|urn:[A-Za-z0-9][A-Za-z0-9:._/-]+)$"}
          ]
        },
        "heldout_unit": {"type": "string", "minLength": 1},
        "train_units": {"type": "integer", "minimum": 1},
        "evaluation_units": {"type": "integer", "minimum": 1}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_arm",
        "candidate_arm",
        "same_base",
        "same_inputs",
        "same_seeds",
        "same_sampling",
        "only_intended_difference"
      ],
      "properties": {
        "base_arm": {"type": "string", "minLength": 1},
        "candidate_arm": {"type": "string", "minLength": 1},
        "same_base": {"const": true},
        "same_inputs": {"const": true},
        "same_seeds": {"const": true},
        "same_sampling": {"const": true},
        "only_intended_difference": {"const": "adapter"}
      }
    },
    "adapter_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trainable_fraction",
        "trainables_outside_adapter",
        "visual_encoder_frozen",
        "action_expert_frozen",
        "save_reload_verified"
      ],
      "properties": {
        "trainable_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "trainables_outside_adapter": {"const": 0},
        "visual_encoder_frozen": {"type": "boolean"},
        "action_expert_frozen": {"type": "boolean"},
        "save_reload_verified": {"const": true}
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "direction",
          "base",
          "candidate",
          "delta",
          "ci95",
          "ci_method",
          "paired",
          "cluster_unit",
          "unit",
          "scale_owner"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "direction": {"enum": ["higher_is_better", "lower_is_better"]},
          "base": {"$ref": "#/$defs/metricNumber"},
          "candidate": {"$ref": "#/$defs/metricNumber"},
          "delta": {"$ref": "#/$defs/metricNumber"},
          "ci95": {
            "type": "array",
            "prefixItems": [
              {"$ref": "#/$defs/metricNumber"},
              {"$ref": "#/$defs/metricNumber"}
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "ci_method": {"type": "string", "minLength": 1},
          "paired": {"const": true},
          "cluster_unit": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "scale_owner": {"type": "string", "minLength": 1}
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_benchmark", "road_safety", "closed_loop_driving", "state_of_the_art"],
      "properties": {
        "official_benchmark": {"const": false},
        "road_safety": {"const": false},
        "closed_loop_driving": {"const": false},
        "state_of_the_art": {"const": false}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_dataset_bytes",
        "contains_raw_outputs",
        "contains_event_identifiers",
        "contains_prompts_or_gold",
        "contains_adapter_weights"
      ],
      "properties": {
        "contains_dataset_bytes": {"const": false},
        "contains_raw_outputs": {"const": false},
        "contains_event_identifiers": {"const": false},
        "contains_prompts_or_gold": {"const": false},
        "contains_adapter_weights": {"const": false}
      }
    }
  }
}
